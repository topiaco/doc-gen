{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apidoc.local/schema/override-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["configVersion", "operations", "schemas"],
  "properties": {
    "configVersion": { "const": "v1" },
    "operations": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/operation" }
    },
    "schemas": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/schemaPatch" }
    }
  },
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operationId": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" },
        "description": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "in", "schema"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "in": { "enum": ["path", "query", "header", "form"] },
              "description": { "type": "string" },
              "required": { "type": "boolean" },
              "schema": { "$ref": "#/$defs/schemaPatch" }
            }
          }
        },
        "body": { "$ref": "#/$defs/schemaPatch" },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "type": "integer", "minimum": 100, "maximum": 599 },
            "description": { "type": "string" },
            "data": { "$ref": "#/$defs/schemaPatch" },
            "example": {},
            "content": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/schemaPatch" }
            }
          }
        }
      }
    },
    "schemaPatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "$ref": { "type": "string", "minLength": 1 },
        "type": { "enum": ["object", "array", "string", "integer", "number", "boolean"] },
        "format": { "type": "string" },
        "description": { "type": "string" },
        "nullable": { "type": "boolean" },
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "properties": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/schemaPatch" }
        },
        "items": { "$ref": "#/$defs/schemaPatch" },
        "additionalProperties": { "$ref": "#/$defs/schemaPatch" },
        "enum": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "name"],
            "properties": {
              "value": {},
              "name": { "type": "string", "minLength": 1 },
              "description": { "type": "string" }
            }
          }
        },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "default": {}
      }
    }
  }
}
