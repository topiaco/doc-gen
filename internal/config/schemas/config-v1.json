{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apidoc.local/schema/config-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "configVersion",
    "project",
    "source",
    "files",
    "analysis",
    "responseFunctions",
    "parameterHelpers",
    "schemaMappings",
    "quality"
  ],
  "properties": {
    "configVersion": { "const": "v1" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "module", "framework", "openapiVersion"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "module": { "type": "string", "minLength": 1 },
        "framework": { "const": "gin" },
        "openapiVersion": { "const": "3.0.3" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routePackages", "controllerPackages", "servicePackages", "modelPackages"],
      "properties": {
        "routePackages": { "$ref": "#/$defs/packagePatterns" },
        "controllerPackages": { "$ref": "#/$defs/packagePatterns" },
        "servicePackages": { "$ref": "#/$defs/packagePatterns" },
        "modelPackages": { "$ref": "#/$defs/packagePatterns" }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection", "overrides", "output", "report"],
      "properties": {
        "selection": { "$ref": "#/$defs/nonEmptyString" },
        "overrides": { "$ref": "#/$defs/nonEmptyString" },
        "output": { "$ref": "#/$defs/nonEmptyString" },
        "report": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conservative", "inferManualRequiredChecks", "fieldDescriptionFallback"],
      "properties": {
        "conservative": { "type": "boolean" },
        "inferManualRequiredChecks": { "type": "boolean" },
        "fieldDescriptionFallback": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["override", "descriptionTag", "trailingComment", "gormComment"]
          }
        }
      }
    },
    "responseFunctions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["symbol", "kind"],
        "properties": {
          "symbol": { "$ref": "#/$defs/nonEmptyString" },
          "kind": { "enum": ["success", "error", "businessError", "binary"] },
          "status": { "type": "integer", "minimum": 100, "maximum": 599 },
          "statusArgument": { "type": "integer", "minimum": 0 },
          "dataArgument": { "type": "integer", "minimum": 0 },
          "wrapper": { "$ref": "#/$defs/nonEmptyString" },
          "mediaType": { "$ref": "#/$defs/nonEmptyString" }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "binary" } } },
            "then": { "required": ["mediaType"] },
            "else": { "required": ["wrapper"] }
          }
        ]
      }
    },
    "parameterHelpers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["symbol", "location", "nameArgument", "type"],
        "properties": {
          "symbol": { "$ref": "#/$defs/nonEmptyString" },
          "location": { "enum": ["path", "query", "header", "form"] },
          "nameArgument": { "type": "integer", "minimum": 0 },
          "type": { "enum": ["string", "integer", "number", "boolean", "array"] },
          "format": { "type": "string" },
          "collectionFormat": { "enum": ["csv", "ssv", "pipes", "multi"] },
          "minimum": { "type": "number" }
        }
      }
    },
    "schemaMappings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema", "diagnostic"],
        "properties": {
          "schema": { "type": "object" },
          "diagnostic": { "type": "boolean" }
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimumRouteDiscoveryCoverage",
        "minimumManagedExactSchemaCoverage",
        "failOnDuplicateOperationID",
        "failOnInvalidOpenAPI",
        "failOnUnresolvedManagedPath",
        "failOnUnknownManagedResponse",
        "failOnOrphanSelection",
        "failOnOrphanOverride"
      ],
      "properties": {
        "minimumRouteDiscoveryCoverage": { "$ref": "#/$defs/percentage" },
        "minimumManagedExactSchemaCoverage": { "$ref": "#/$defs/percentage" },
        "failOnDuplicateOperationID": { "type": "boolean" },
        "failOnInvalidOpenAPI": { "type": "boolean" },
        "failOnUnresolvedManagedPath": { "type": "boolean" },
        "failOnUnknownManagedResponse": { "type": "boolean" },
        "failOnOrphanSelection": { "type": "boolean" },
        "failOnOrphanOverride": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "packagePatterns": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "percentage": { "type": "integer", "minimum": 0, "maximum": 100 }
  }
}
